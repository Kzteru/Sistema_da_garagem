@model List<VeiculoStatusViewModel>
@{
    ViewData["Title"] = "Veículos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Veículos</h1>
    <a asp-action="Create" class="btn btn-primary">+ Novo veículo</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Nenhum veículo cadastrado ainda.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Placa</th>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th>Ano</th>
                        <th>Cor</th>
                        <th>Hoje</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var v = item.Veiculo;
                        <tr>
                            <td class="fw-semibold text-nowrap">@v.Placa</td>
                            <td>@v.Marca</td>
                            <td>@v.Modelo</td>
                            <td>@v.Ano</td>
                            <td>@(string.IsNullOrWhiteSpace(v.Cor) ? "—" : v.Cor)</td>
                            <td>
                                @if (item.Disponivel)
                                {
                                    <span class="badge bg-success">Disponível</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Reservado</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <form asp-action="Delete" asp-route-id="@v.Id" method="post" class="d-inline"
                                      data-confirmacao="Excluir o veículo @(v.Placa)? Esta ação não pode ser desfeita."
                                      onsubmit="return confirm(this.dataset.confirmacao);">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted small mt-2">@Model.Count veículo(s) cadastrado(s).</p>
}
