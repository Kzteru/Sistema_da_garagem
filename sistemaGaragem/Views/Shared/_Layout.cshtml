@{
    var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString();
    string Ativo(string controller) => controllerAtual == controller ? "active" : "";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Garagem de Veículos</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-controller="Reserva" asp-action="Index">🚗 Garagem de Veículos</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                    aria-controls="menu" aria-expanded="false" aria-label="Abrir menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link @Ativo("Reserva")" asp-controller="Reserva" asp-action="Index">Reservas</a></li>
                    <li class="nav-item"><a class="nav-link @Ativo("Pessoa")" asp-controller="Pessoa" asp-action="Index">Pessoas</a></li>
                    <li class="nav-item"><a class="nav-link @Ativo("Veiculo")" asp-controller="Veiculo" asp-action="Index">Veículos</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container pb-5">
        @if (TempData["Sucesso"] is string sucesso)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @sucesso
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        }
        @if (TempData["Erro"] is string erro)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @erro
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="border-top py-3 text-center text-muted small">
        Garagem de Veículos · Arquitetura de Software (ESW430) · UniRV
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
