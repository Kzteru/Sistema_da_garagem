<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>sistemaGaragem</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Os arquivos de dados mudam enquanto o sistema roda: não reiniciar o "dotnet watch" por causa deles -->
    <Content Update="Data\**\*.json" Watch="false" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
